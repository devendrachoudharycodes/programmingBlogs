---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
---

<header>
	<nav>
		<h2><a href={baseUrl}>{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href={baseUrl}>Home</HeaderLink>
			<HeaderLink href={`${baseUrl}blog/`}>Blog</HeaderLink>
			<HeaderLink href={`${baseUrl}about/`}>About</HeaderLink>
		</div>
		<div class="social-links">
			<a href="https://in.linkedin.com/in/devendra-choudhary-1b6534400" target="_blank">
				<span class="sr-only">Follow Devendra Choudhary on Linkedin</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M3.58 2.01A1.67 1.67 0 1 1 .24 2.01a1.67 1.67 0 0 1 3.34 0ZM.47 4.94h3.12V15H.47V4.94Zm4.99 0h2.99v1.38h.04c.42-.79 1.44-1.62 2.97-1.62 3.18 0 3.77 2.09 3.77 4.81V15h-3.12V10.1c0-1.17-.02-2.68-1.63-2.68-1.63 0-1.88 1.27-1.88 2.59V15H5.46V4.94Z"
					></path>
				</svg>
			</a>
			<a href="https://x.com/ChoudharyCodes" target="_blank">
				<span class="sr-only">Follow Devendra Choudhary on X</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32">
					<path
						fill="currentColor"
						d="M12.6 1.125h2.205l-4.818 5.507 5.667 7.118h-4.45L7.72 9.204l-3.987 4.546H1.086l5.153-5.89L.782 1.125h4.565l3.151 4.169 3.662-4.169Zm-.774 11.68h1.222L4.722 2.75H3.411l8.415 10.055Z"
					></path>
				</svg>
			</a>
			<a href="https://github.com/devendrachoudharycodes" target="_blank">
				<span class="sr-only">Go to Devendra Choudhary's Github</span>
				<svg viewBox="0 0 16 16" aria-hidden="true" width="32" height="32"
					><path
						fill="currentColor"
						d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.012 8.012 0 0 0 16 8c0-4.42-3.58-8-8-8z"
					></path></svg
				>
			</a>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: white;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		max-width: 1200px;
		margin: 0 auto;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--black);
		border-bottom: 4px solid transparent;
		text-decoration: none;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
