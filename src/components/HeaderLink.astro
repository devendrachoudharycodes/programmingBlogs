---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, class: className, ...props } = Astro.props;

const currentPath = Astro.url.pathname;
const normalizedHref = typeof href === 'string' ? href : String(href);
const normalizedBase = import.meta.env.BASE_URL.replace(/\/$/, '');

const cleanPath = currentPath.replace(normalizedBase, '').replace(/^\//, '');
const cleanHref = normalizedHref.replace(normalizedBase, '').replace(/^\//, '');

const pathSegment = cleanPath.split('/')[0];
const hrefSegment = cleanHref.split('/')[0];

const isActive =
	normalizedHref === currentPath ||
	cleanHref === cleanPath ||
	(hrefSegment !== '' && hrefSegment === pathSegment);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
	<slot />
</a>
<style>
	a {
		display: inline-block;
		text-decoration: none;
	}
	a.active {
		font-weight: bolder;
		text-decoration: underline;
	}
</style>
