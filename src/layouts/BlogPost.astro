---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	author,
	category,
	series,
	seriesOrder,
	tags,
	draft,
	featured,
	canonicalURL,
} = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} canonicalURL={canonicalURL} />
		<style>
			main {
				width: 100%;
				max-width: 100%;
				margin: 0 auto;
			}
			.hero-image {
				width: 100%;
				display: flex;
				justify-content: center;
				padding: 1rem 0;
			}
			.hero-image img {
				display: block;
				margin: 0 auto;
				max-width: 220px;
				max-height: 140px;
				width: auto;
				height: auto;
				object-fit: contain;
			}
			.prose {
				width: 100%;
				max-width: 1200px;
				margin: 0 auto;
				padding: 1em 0;
				color: rgb(var(--gray-dark));
			}
			.title {
				margin-bottom: 1em;
				padding: 1em 0;
				text-align: center;
				line-height: 1;
			}
			.title h1 {
				margin: 0 0 0.5em 0;
			}
			.taxonomy {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.5em;
				margin-bottom: 0.75em;
				font-size: 0.875rem;
			}
			.category-badge {
				background-color: rgb(var(--gray-light));
				color: var(--accent);
				font-weight: 600;
				padding: 0.25em 0.6em;
				border-radius: 4px;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			.series-badge {
				background-color: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.25em 0.6em;
				border-radius: 4px;
				font-weight: 500;
			}
			.badge-draft {
				background-color: #fee2e2;
				color: #991b1b;
				padding: 0.25em 0.6em;
				border-radius: 4px;
				font-weight: 600;
			}
			.badge-featured {
				background-color: #fef3c7;
				color: #92400e;
				padding: 0.25em 0.6em;
				border-radius: 4px;
				font-weight: 600;
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				align-items: center;
				gap: 0.5em;
				margin-bottom: 0.5em;
				color: rgb(var(--gray));
			}
			.author {
				font-weight: 500;
				color: rgb(var(--gray-dark));
			}
			.date {
				margin-bottom: 0;
				color: rgb(var(--gray));
			}
			.last-updated-on {
				font-style: italic;
			}
			.tags {
				display: flex;
				flex-wrap: wrap;
				justify-content: center;
				gap: 0.5em;
				margin-top: 1em;
			}
			.tag {
				background-color: rgb(var(--gray-light));
				color: rgb(var(--gray-dark));
				padding: 0.2em 0.6em;
				border-radius: 9999px;
				font-size: 0.85rem;
				text-decoration: none;
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="hero-image">
					{
						heroImage && (
							typeof heroImage === 'string' ? (
								<img width={1020} height={510} src={heroImage} alt="" />
							) : (
								<Image width={1020} height={510} src={heroImage} alt="" />
							)
						)
					}
				</div>
				<div class="prose">
					<div class="title">
						{
							(category || series || draft || featured) && (
								<div class="taxonomy">
									{draft && <span class="badge-draft">Draft</span>}
									{featured && <span class="badge-featured">Featured</span>}
									{category && <span class="category-badge">{category}</span>}
									{series && (
										<span class="series-badge">
											{series}
											{seriesOrder && ` (Part ${seriesOrder})`}
										</span>
									)}
								</div>
							)
						}
						<h1>{title}</h1>
						<div class="meta">
							{author && <span class="author">By {author}</span>}
							{author && (pubDate || updatedDate) && <span>•</span>}
							<div class="date">
								<FormattedDate date={pubDate} />
								{
									updatedDate && (
										<span class="last-updated-on">
											(Updated on <FormattedDate date={updatedDate} />)
										</span>
									)
								}
							</div>
						</div>
						{
							tags && tags.length > 0 && (
								<div class="tags">
									{tags.map((tag) => (
										<span class="tag">#{tag}</span>
									))}
								</div>
							)
						}
						<hr />
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>
